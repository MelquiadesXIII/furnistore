# URL base de la API .NET.
# Sin prefijo NEXT_PUBLIC_ a propósito: solo se usa en el servidor, así la URL
# del backend nunca llega al bundle del navegador.
API_BASE_URL=http://localhost:5135

# URL del proyecto de Supabase donde vive el bucket de imágenes de producto.
# La usa next.config.ts para autorizar ese hostname en next/image.
SUPABASE_URL=https://yjckqaxvulvdlvaenqzk.supabase.co
